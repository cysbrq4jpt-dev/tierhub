## 7. Firebase Security Rules

```javascript
// firebase/firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTierList() {
      let data = request.resource.data;
      return data.title.size() > 0 &&
             data.title.size() <= 100 &&
             data.categoryId.size() > 0;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['id', 'createdAt', 'followersCount', 'followingCount', 'tierListsCount']);
      allow delete: if false;
    }

    // Tier Lists Collection
    match /tierLists/{tierListId} {
      allow read: if resource.data.isPublic == true || isOwner(resource.data.userId);
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidTierList();
      allow update: if isOwner(resource.data.userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(['id', 'userId', 'createdAt', 'likesCount', 'commentsCount', 'viewsCount']);
      allow delete: if isOwner(resource.data.userId);
    }

    // Tier Items Collection
    match /tierItems/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false; // 運営のみ（Admin SDK経由）
    }

    // Master Items Collection
    match /masterItems/{itemId} {
      allow read: if true;
      allow write: if false; // 運営のみ
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.content.size() > 0 &&
                       request.resource.data.content.size() <= 1000;
      allow update: if isOwner(resource.data.userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt']);
      allow delete: if isOwner(resource.data.userId);
    }

    // Likes Collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    // Follows Collection
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.followerId == request.auth.uid &&
                       request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isAuthenticated() &&
                       resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Votes Collection
    match /votes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
