# ===========================================
# OpenClaw Environment Variables
# ===========================================
# このファイルをコピーして .env を作成してください:
#   cp openclaw/.env.example openclaw/.env
#
# 注意: 実際のトークンは絶対にコミットしないでください

# --- AI Provider ---
# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Discord Channel ---
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_BOT_TOKEN=your-discord-bot-token

# --- Slack Channel ---
# Slack API (https://api.slack.com/apps) で取得
# App Token (xapp-...) - Socket Mode 用
SLACK_APP_TOKEN=xapp-your-slack-app-token
# Bot User OAuth Token (xoxb-...) - Bot 操作用
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
